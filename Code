function watchIncomingTrades(){
  if(!MP.lobbyRef||!FBUSER)return;
  const tr=MP.lobbyRef.child('trades');
  const cb=s=>{
    const d=s.val();if(!d||d.status!=='pending'||d.to!==FBUSER.uid)return;
    if(Math.abs(Date.now()-(d.createdAt||Date.now()))>5*60*1000)return;
    if(tradeState){s.ref.update({status:'cancelled',reason:'busy'}).catch(()=>{});return}
    beginTrade(s.key,s.ref,d.from,false);
  };
  tr.on('child_added',cb);
