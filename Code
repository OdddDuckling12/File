/* ===== Fresh & inviting theme (aqua · mint · sunshine) ===== */
:root{--ink:#27406a;--ink2:#2d6a9a;--mint:#2fc79c;--sky:#8fd8ff}
.p{background:linear-gradient(180deg,#ffffffee,#e6f6ffe6);border:3px solid #fff;border-radius:32px;color:var(--ink);box-shadow:0 7px 0 #bfe6ff99,0 16px 34px #3a8fd840,inset 0 4px 8px #fff,inset 0 -8px 16px #9fdcff33;backdrop-filter:blur(14px) saturate(1.35)}
.p::before{background:linear-gradient(180deg,#ffffffc8,#fff0)}
